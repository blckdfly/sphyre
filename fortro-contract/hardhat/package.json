{
  "name": "sphyre-contracts",
  "version": "1.0.0",
  "description": "Sphyre SSI Registry Smart Contracts with Meta-Transaction Support",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:forwarder:sepolia": "hardhat run scripts/deploy-forwarder.ts --network baseSepolia",
    "deploy:registries:sepolia": "hardhat run scripts/deploy-registries.ts --network baseSepolia",
    "admin:set:sepolia": "hardhat run scripts/set-forwarder-and-roles.ts --network baseSepolia",
    "verify:sepolia": "hardhat run scripts/verify.ts --network baseSepolia",
    "abi:export": "hardhat run scripts/export-abi.ts",
    "clean": "hardhat clean"
